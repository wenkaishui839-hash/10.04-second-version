#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#define _USE_MATH_DEFINES
#include <math.h>

extern void execute_rdfft_scalar(float* Y, const float* W_re, const float* W_im, int N);
extern void generate_rdfft_twiddle_factors(float* W_re, float* W_im, int N);

/* 纳秒级计时 */
static double now_ns(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1e9 + ts.tv_nsec;
}

/* 参考 DFT (O(N²), 用于对比加速比) */
void naive_dft(const float* x, int N, float* out_re, float* out_im) {
    for (int k = 0; k <= N / 2; k++) {
        double sum_re = 0.0, sum_im = 0.0;
        for (int n = 0; n < N; n++) {
            double angle = -2.0 * M_PI * k * n / (double)N;
            sum_re += x[n] * cos(angle);
            sum_im += x[n] * sin(angle);
        }
        out_re[k] = (float)sum_re;
        out_im[k] = (float)sum_im;
    }
}

int main() {
    const int test_N[] = {64, 256, 1024, 4096};
    const int num_tests = sizeof(test_N) / sizeof(test_N[0]);

    printf("%8s  %12s  %10s  %10s  %10s  %12s\n",
           "N", "Reps", "rdFFT(ns)", "DFT(ns)", "Speedup", "log2(N)");
    printf("--------  ------------  ----------  ----------  ----------  ------------\n");

    for (int t = 0; t < num_tests; t++) {
        int N = test_N[t];

        /* 根据规模调整重复次数 */
        int reps;
        if (N <= 256) reps = 100000;
        else if (N <= 1024) reps = 10000;
        else reps = 1000;

        float* x       = (float*)malloc(N * sizeof(float));
        float* Y       = (float*)malloc(N * sizeof(float));
        float* W_re    = (float*)malloc((N / 2) * sizeof(float));
        float* W_im    = (float*)malloc((N / 2) * sizeof(float));
        float* dft_re  = (float*)malloc((N / 2 + 1) * sizeof(float));
        float* dft_im  = (float*)malloc((N / 2 + 1) * sizeof(float));

        /* 构造随机信号 */
        for (int n = 0; n < N; n++) {
            x[n] = (float)(sin(2.0 * M_PI * n / N)
                         + 0.5 * sin(4.0 * M_PI * n / N)
                         + 0.25 * sin(8.0 * M_PI * n / N));
        }

        /* 预生成旋转因子 (不在计时代码内) */
        generate_rdfft_twiddle_factors(W_re, W_im, N);

        /* --- rdFFT 计时 --- */
        double t_rdfft_start = now_ns();
        for (int r = 0; r < reps; r++) {
            for (int n = 0; n < N; n++) Y[n] = x[n];  /* 重置输入 */
            execute_rdfft_scalar(Y, W_re, W_im, N);
        }
        double t_rdfft = (now_ns() - t_rdfft_start) / reps;

        /* --- 参考 DFT 计时 (rep 减半, 因为 DFT 太慢) --- */
        int reps_dft = (reps > 10) ? reps / 10 : 1;
        double t_dft_start = now_ns();
        for (int r = 0; r < reps_dft; r++) {
            naive_dft(x, N, dft_re, dft_im);
        }
        double t_dft = (now_ns() - t_dft_start) / reps_dft;

        printf("%8d  %12d  %10.0f  %10.0f  %9.1fx  %12.1f\n",
               N, reps, t_rdfft, t_dft, t_dft / t_rdfft, log2(N));

        free(x); free(Y); free(W_re); free(W_im); free(dft_re); free(dft_im);
    }

    printf("\n理论复杂度: rdFFT O(N logN), DFT O(N^2)\n");
    return 0;
}
